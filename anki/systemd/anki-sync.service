[Unit]
Description=Sync headless Anki (vault-mcp) with AnkiWeb
After=docker.service

[Service]
Type=oneshot
User=thepythonist
# AnkiConnect inside the container; the key never leaves the container environment.
ExecStart=/usr/bin/docker exec vault-mcp-anki-1 sh -c "curl -s -m 120 http://127.0.0.1:8765 -d \"{\\\"action\\\":\\\"sync\\\",\\\"version\\\":6,\\\"key\\\":\\\"$$ANKICONNECT_API_KEY\\\"}\""
