# --- Public URL (own Funnel port, so /.well-known does not clash with imap-mcp) ---
NEXT_PUBLIC_APP_URL=https://jarvis.tail4828ff.ts.net:8443

# --- Secrets (generate: openssl rand -base64 32) ---
APP_SECRET=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME

# --- Clerk (same app as imap-mcp) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# --- Who may use the vault (comma-separated Clerk user IDs). Empty = nobody. ---
ALLOWED_CLERK_USER_IDS=user_...

# --- Vault ---
VAULT_HOST_PATH=/home/thepythonist/vault
VAULT_UID=1000
VAULT_GID=1000
# Top-level folders Claude can neither see nor change (comma-separated), e.g. Tagebuch,Privat
VAULT_HIDDEN_FOLDERS=
# Folders proposals may target; empty = all visible folders. Use "." for the vault root.
VAULT_WRITABLE_FOLDERS=

# --- OAuth ---
# Exact allowed redirect URIs; empty = Claude's hosted callbacks (claude.ai / claude.com).
ALLOWED_REDIRECT_URIS=
# Allow http://localhost:* callbacks (Claude Code). Set to false to disable.
ALLOW_LOOPBACK_REDIRECTS=true
OAUTH_ACCESS_TOKEN_TTL=3600
OAUTH_REFRESH_TOKEN_TTL=2592000

# --- Proposals ---
PROPOSAL_TTL_SECONDS=604800
# Optional push on new proposals (path + kind only, never content), e.g. https://ntfy.sh/<random-topic>
NTFY_URL=
